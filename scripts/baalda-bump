#!/usr/bin/env bash
# Bump the pinned Baalda release (server tag + desktop .deb) to the newest on GitHub (no token needed).
# The .deb hash is the SHA-256 digest GitHub reports for the asset, so nothing is downloaded.
# Rewrites pkgs/baalda/baalda.json only; commit and nru yourself.
set -euo pipefail
cd "$(dirname "$0")/.."
out=pkgs/baalda/baalda.json
repo=naveedharri/baalda

rel=$(curl -fsS "https://api.github.com/repos/$repo/releases/latest")
tag=$(jq -r .tag_name <<<"$rel")
version=${tag#v}
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "unexpected release tag: $tag" >&2; exit 1; }
cur=$(jq -r .version "$out")
if [ "$version" = "$cur" ]; then echo "already on $version"; exit 0; fi
# Never downgrade.
[ "$(printf '%s\n%s\n' "$cur" "$version" | sort -V | tail -1)" = "$version" ] || { echo "already on $cur"; exit 0; }

hex=$(jq -r --arg f "Baalda_${version}_amd64.deb" '.assets[] | select(.name == $f) | .digest // empty' <<<"$rel" \
  | sed 's/^sha256://')
[[ "$hex" =~ ^[0-9a-f]{64}$ ]] || { echo "no sha256 digest for $version amd64 .deb" >&2; exit 1; }
sri=$(nix hash convert --hash-algo sha256 --to sri "$hex")

jq -n --arg v "$version" --arg h "$sri" '{version:$v, hash:$h}' > "$out"
echo "pinned $version"
