# ===========================================================================
# modules/system/graphical/firefox.nix — Firefox
#
# Installs Firefox with a managed policy, a pywalfox native messaging
# manifest and the dotfiles userChrome.css. Turn it on by importing this
# file from a host; remove the import to turn it off.
#
# Option of this module:
#   programs.firefox.deSlop.enable   (default true) loads
#     firefox/policies.json from the dotfiles input into
#     programs.firefox.policies: telemetry, AI and password manager off,
#     uBlock Origin and Proton Pass force-installed, uBlock preloaded with a
#     hardened filter list plus the yt-shorts hider
#     (github.com/gijsdev/ublock-hide-yt-shorts). Set false to opt out.
#
# Upstream programs.firefox options, not set here:
#   package / languagePacks          Firefox build and language packs
#   preferences / preferencesStatus  locked about:config prefs and how they
#                                    apply (default, locked, user, clear)
#   autoConfig / autoConfigFiles     mozilla.cfg JavaScript
#   nativeMessagingHosts.packages    native messaging host packages (an
#                                    alternative to the hand-written
#                                    pywalfox manifest below)
#
# The uBlock filterLists/externalLists set is duplicated in
# dotfiles/chromium/policies.json (same extension, other browser); keep the
# two in sync by hand.
# ===========================================================================

{ config, lib, inputs, ... }:

let
  cfg = config.programs.firefox;
in

{
  options.programs.firefox.deSlop.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "Deploy the de-slop managed policy (dotfiles/firefox/policies.json).";
  };

  config = lib.mkMerge [
    {
      programs.firefox.enable = true;
    }

    (lib.mkIf cfg.deSlop.enable {
      programs.firefox.policies =
        (builtins.fromJSON (builtins.readFile "${inputs.dotfiles}/firefox/policies.json")).policies;
    })

    {
      # userChrome.css + pywalfox native-messaging manifest — applies to
      # every user on every host that imports this module.
      home-manager.sharedModules = [
        ({ lib, pkgs, ... }: {
          # pywalfox's native messaging manifest, at the fixed path
          # ~/.mozilla/native-messaging-hosts/ (no profile needed, unlike
          # userChrome.css below). The content copies the package's own
          # template (pywalfox/assets/manifest.json with "<path>" filled in)
          # and is maintained by hand.
          home.file.".mozilla/native-messaging-hosts/pywalfox.json" = {
            force = true; # overwrite any existing hand-made copy of this file
            text = builtins.toJSON {
              name = "pywalfox";
              description = "Automatically theme your browser using the colors generated by Pywal";
              path = "/run/current-system/sw/bin/pywalfox";
              type = "stdio";
              allowed_extensions = [ "pywalfox@frewacom.org" ];
            };
          };

          # userChrome.css — the profile directory has a random prefix
          # (e.g. yhtttubw.default under ~/.config/mozilla/firefox/), so it
          # cannot be a fixed home.file path. An activation script would
          # find nothing before Firefox's first launch. Instead a path unit
          # runs the service as soon as a *.default* profile exists, and the
          # service symlinks ~/dotfiles/firefox/userChrome.css into
          # <profile>/chrome/.
          systemd.user.services.firefoxUserChrome = {
            Unit.Description = "Symlink userChrome.css into the Firefox profile";
            Service = {
              Type = "oneshot";
              # PathExistsGlob (below) re-triggers whenever this unit goes
              # inactive while the glob still matches — i.e. forever once a
              # profile exists. Staying "active" after the one run stops that.
              RemainAfterExit = true;
              Environment = [
                "SHELL=/bin/sh"
                "PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:/usr/bin:/bin"
              ];
              ExecStart = pkgs.writeShellScript "firefox-userchrome" ''
                _profile=$(ls -d "$HOME/.config/mozilla/firefox/"*.default* 2>/dev/null | head -1)
                if [ -n "$_profile" ]; then
                  mkdir -p "$_profile/chrome"
                  ln -sf "$HOME/dotfiles/firefox/userChrome.css" "$_profile/chrome/userChrome.css"
                fi
              '';
            };
          };

          systemd.user.paths.firefoxUserChrome = {
            Unit.Description = "Watch for the Firefox profile directory to exist";
            Path.PathExistsGlob = "%h/.config/mozilla/firefox/*.default*";
            Install.WantedBy = [ "graphical-session.target" ];
          };
        })
      ];
    }
  ];

  # gfx.color_management.hdr stays unset. Tested 2026-11-21 on Umbriel with
  # Firefox 160: HDR video looks right, but with the pref on every SDR video
  # gets a red tint (open upstream bug, bugzilla 2083037: Firefox advertises
  # YUV formats the compositor does not sample correctly). Since most video is
  # SDR the default stays off. For an HDR session, flip the pref in
  # about:config and flip it back after. Retest once widget.wayland.hdr.convert-yuv-to-rgb
  # exists in the shipped build (absent in 160).
}
